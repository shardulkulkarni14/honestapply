# ---------------------------------------------------------------------------
# honestapply environment — copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Which LLM provider to use for scoring / tailoring / cover letters.
# One of: claude_cli | anthropic | gemini | openai   (default: anthropic)
#   claude_cli -> shells out to your local `claude` CLI (Claude Code login).
#                 NO API key, no per-token API billing. Slower per call. Best if
#                 you already use Claude Code. Set the model alias via CLAUDE_CLI_MODEL.
#   anthropic/gemini/openai -> use the matching *_API_KEY below.
LLM_PROVIDER=anthropic

# Model for the key-free claude_cli provider (sonnet | opus | haiku).
CLAUDE_CLI_MODEL=sonnet

# Default models per provider (override if you like).
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# --- API keys (only the one matching LLM_PROVIDER is required) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Paths (sensible defaults; override only if you must) ---
# SQLite DB location.
HONESTAPPLY_DB_PATH=data/honestapply.db
# Persistent browser profile for the apply stage (login sessions survive here).
HONESTAPPLY_BROWSER_PROFILE=~/.honestapply/browser-profile

# --- Safety knobs (can also be set in config; env wins) ---
# Seconds to wait between submissions to the same domain.
HONESTAPPLY_RATE_LIMIT_SECONDS=90
# Max real submissions per day (hard ceiling is 50, enforced in code).
HONESTAPPLY_DAILY_CAP=25
# Per-employer caps so one company is never sprayed with applications:
# a rolling-24h cap, and a cumulative lifetime cap (0 disables the lifetime one).
HONESTAPPLY_PER_COMPANY_DAILY_CAP=2
HONESTAPPLY_PER_COMPANY_TOTAL_CAP=2
# Minimum fit score (1-10) for a job to proceed past `score`.
HONESTAPPLY_MIN_SCORE=7

# --- Prepare-stage concurrency (enrich / score / tailor / cover-letter) ---
# Jobs prepared at once. 1 = serial (the default); 3 is the recommended value
# once you trust the run — the stages are LLM-bound, so a few threads overlap
# the waits. Apply is never parallel regardless of this setting.
HONESTAPPLY_PREPARE_WORKERS=1
# Optional: score with a different provider than tailor/cover-letter, e.g.
# `anthropic` (API key needed) while the rest stays on the key-free claude_cli.
# Leave empty to score with LLM_PROVIDER.
HONESTAPPLY_SCORE_PROVIDER=
# When a worker hits an LLM usage/rate limit, all workers pause this long.
HONESTAPPLY_LLM_PAUSE_SECONDS=120
